{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "composite": false
  },
  "include": [
    "kibana.d.ts",
    "typings/**/*.d.ts",
    "src/**/*.ts",
