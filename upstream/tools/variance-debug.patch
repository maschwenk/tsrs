diff --git a/tsc/internal/checker/zz_symdump.go b/tsc/internal/checker/zz_symdump.go
new file mode 100644
index 0000000000..499bddce48
--- /dev/null
+++ b/tsc/internal/checker/zz_symdump.go
@@ -0,0 +1,70 @@
+package checker
+
+import (
+	"fmt"
+	"os"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/microsoft/TypeScript/tsc/internal/ast"
+)
+
+var symDumpDir = os.Getenv("TSGO_SYMDUMP")
+
+var sixNames = map[string]bool{"id": true, "name": true, "scope": true, "service": true, "type": true, "version": true}
+
+var stackHists sync.Map // *Checker -> map[string]int
+
+func (c *Checker) recordMappedMember(t *Type, name string) {
+	if !sixNames[name] {
+		return
+	}
+	v, _ := stackHists.LoadOrStore(c, map[string]int{})
+	m := v.(map[string]int)
+	pcs := make([]uintptr, 48)
+	n := runtime.Callers(3, pcs)
+	frames := runtime.CallersFrames(pcs[:n])
+	var b strings.Builder
+	d := t.AsMappedType().declaration
+	alias := ""
+	if t.alias != nil {
+		alias = t.alias.symbol.Name
+	}
+	mod := ""
+	if mt := t.AsMappedType().modifiersType; mt != nil && mt.symbol != nil {
+		mod = mt.symbol.Name
+	}
+	fmt.Fprintf(&b, "%s\tmapped id=%d alias=%s mod=%s decl=%s:%d", name, t.id, alias, mod, ast.GetSourceFileOfNode(d.AsNode()).FileName(), d.Pos())
+	for {
+		f, more := frames.Next()
+		fn := f.Function[strings.LastIndexByte(f.Function, '.')+1:]
+		fmt.Fprintf(&b, " <- %s:%d", fn, f.Line)
+		if !more {
+			break
+		}
+	}
+	m[b.String()]++
+}
+
+func (c *Checker) DumpSymbols(idx int) {
+	if symDumpDir == "" {
+		return
+	}
+	v, ok := stackHists.Load(c)
+	if !ok {
+		return
+	}
+	m := v.(map[string]int)
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var b strings.Builder
+	for _, k := range keys {
+		fmt.Fprintf(&b, "%d\t%s\n", m[k], k)
+	}
+	os.WriteFile(fmt.Sprintf("%s/checker-%d.txt", symDumpDir, idx), []byte(b.String()), 0o644)
+}
