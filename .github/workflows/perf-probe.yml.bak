# Manual Linux performance probe on a GitHub-hosted runner (bench/README.md).
# Push the branch, then run:
#   gh workflow run perf-probe.yml --ref <branch> -f projects=vscode,formbricks-web \
#     -f script=tools/perf/leafprobe.sh -f probe_args='--reps 5'
# Builds the release binary for relative comparisons, restores bench.yml's project caches and runs the selected
# script. Download probe-out/ with `gh run download <run-id> -n perf-probe`.

name: Perf probe

on:
  workflow_dispatch:
    inputs:
      projects:
        description: comma-separated bench/projects.json names to set up
        default: vscode
      runner:
        description: GitHub-hosted Linux x64 runner label
        default: ubuntu-24.04
      script:
        description: probe script to run with bash
        default: tools/perf/probe.sh
      probe_args:
        description: passed to the probe script as PROBE_ARGS
        default: ""

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always
  PROBE_PROJECTS: ${{ inputs.projects || 'vscode' }}

jobs:
  probe:
    runs-on: ${{ inputs.runner || 'ubuntu-24.04' }}
    timeout-minutes: 240
    steps:
      - name: Free disk space for builds and benchmark checkouts
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /usr/local/share/boost
          df -h /

      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          persist-credentials: false

      - name: Runner hardware
        run: |
          nproc; free -g; uname -r
          lscpu | grep -E 'Model name|^CPU\(s\)|Thread|Socket|NUMA' || true
          if [ "$(uname -m)" != x86_64 ]; then
            echo "::error::expected x86_64, got $(uname -m)"; exit 1
          fi
          mkdir -p probe-out
          { nproc; lscpu; free -g; } > probe-out/machine.txt

      - uses: oxc-project/setup-node@f46a72f95efdc55273fcd042d61c84e723b2892c # v1.4.1
        with:
          registry-url: "" # Public benchmark installs use Yarn 1, which rejects an unset NODE_AUTH_TOKEN.

      - name: Install Bun canary and perf
        run: |
          sudo apt-get install -y -qq strace >/dev/null 2>&1 || echo "strace not installed"
          curl -fsSL -o /tmp/bun.zip https://github.com/oven-sh/bun/releases/download/canary/bun-linux-x64.zip
          unzip -oq /tmp/bun.zip -d /tmp/bun
          /tmp/bun/bun-linux-x64/bun --revision
          # linux perf is best-effort: the packaged tools may not match the runner kernel.
          (sudo apt-get update -qq && sudo apt-get install -y -qq linux-tools-common linux-tools-generic >/dev/null 2>&1 \
            && ls /usr/lib/linux-tools/*/perf) || echo "perf not installed"
          sudo sysctl -q -w kernel.perf_event_paranoid=-1 kernel.kptr_restrict=0 || true

      - uses: oxc-project/setup-rust@3d6fb132fbe7cdcb66bf8ec193911c2945369d12 # v1.0.17
        with:
          components: llvm-tools
          save-cache: true
          cache-key: perf-probe-${{ inputs.runner || 'ubuntu-24.04' }}

      - name: Install x86_64-unknown-linux-gnu target
        run: rustup target add x86_64-unknown-linux-gnu

      # bench.yml's caches (restore only).
      - name: Cache keys
        id: keys
        run: python3 bench/run.py --print-cache-keys --projects "$PROBE_PROJECTS" | tee -a "$GITHUB_OUTPUT"

      - name: Restore suite and compilers
        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          path: |
            bench/.work/suite
            bench/.work/tsgo
          key: bench-shared-${{ runner.os }}-${{ steps.keys.outputs.shared }}

      - name: Restore vscode
        if: steps.keys.outputs['vscode'] != ''
        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          path: bench/.work/solutions/vscode
          key: bench-vscode-${{ runner.os }}-${{ steps.keys.outputs['vscode'] }}

      - name: Restore formbricks-web
        if: steps.keys.outputs['formbricks-web'] != ''
        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          path: bench/.work/solutions/formbricks-web
          key: bench-formbricks-web-${{ runner.os }}-${{ steps.keys.outputs['formbricks-web'] }}

      - name: Restore xstate-main
        if: steps.keys.outputs['xstate-main'] != ''
        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          path: bench/.work/solutions/xstate-main
          key: bench-xstate-main-${{ runner.os }}-${{ steps.keys.outputs['xstate-main'] }}

      - name: Restore supabase-studio
        if: steps.keys.outputs['supabase-studio'] != ''
        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          path: bench/.work/solutions/supabase-studio
          key: bench-supabase-studio-${{ runner.os }}-${{ steps.keys.outputs['supabase-studio'] }}

      - name: Restore t3code-server
        if: steps.keys.outputs['t3code-server'] != ''
        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
        with:
          path: bench/.work/solutions/t3code-server
          key: bench-t3code-server-${{ runner.os }}-${{ steps.keys.outputs['t3code-server'] }}

      - name: Set up projects and compilers
        run: python3 bench/run.py --setup-only --projects "$PROBE_PROJECTS"

      - name: Build tsrs (release)
        run: cargo build --release --locked -p tsrs_cli

      - name: Probe
        env:
          TSRS_BIN: ${{ github.workspace }}/target/release/tsrs
          BUN_BIN: /tmp/bun/bun-linux-x64/bun
          BENCH_WORK: ${{ github.workspace }}/bench/.work
          PROBE_OUT: ${{ github.workspace }}/probe-out
          PROBE_ARGS: ${{ inputs.probe_args || '' }}
          PROBE_SCRIPT: ${{ inputs.script || 'tools/perf/probe.sh' }}
        run: bash "$PROBE_SCRIPT"

      - name: Upload probe output
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: perf-probe
          path: probe-out
          if-no-files-found: warn
